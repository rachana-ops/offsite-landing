{
  "name": "nancy-bridge",
  "private": true,
  "scripts": {
    "check:no-legacy-navigation": "node scripts/check-no-legacy-navigation.mjs",
    "test": "node --test tests/*.test.mjs",
    "vercel-build": "npm run build:wellness && npm test && npm run check:no-legacy-navigation",
    "build:wellness": "node scripts/build-wellness.mjs",
    "wellness-build": "npm run vercel-build && node scripts/stage-wellness.mjs",
    "deploy:wellness": "node scripts/deploy-wellness.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "lucide-react": "0.453.0",
    "@radix-ui/react-slot": "1.2.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "tailwind-merge": "3.3.1"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "@tailwindcss/cli": "4.1.14",
    "tailwindcss": "4.1.14",
    "tw-animate-css": "1.4.0"
  }
}
